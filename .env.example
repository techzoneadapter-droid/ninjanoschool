# Copy to .env and fill BOTH passwords before starting Docker or the game server.
# Keep .env private; it is ignored by Git.
NSO_DB_ROOT_PASSWORD=
NSO_MYSQL_PASSWORD=
# Java app and MariaDB share the local host; DB is NOT exposed to the public internet.
NSO_MYSQL_HOST=127.0.0.1
NSO_MYSQL_PORT=3306
NSO_MYSQL_USER=nso
NSO_MYSQL_DATABASE_DATA=nsohuyda_data
NSO_MYSQL_DATABASE_ACCOUNT=nsohuyda_account
NSO_PORT=14444
NSO_BIND_HOST=127.0.0.1
NSO_PUBLIC_HOST=127.0.0.1
